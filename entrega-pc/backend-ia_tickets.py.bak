# ==========================================================================
# Normalización server-side (función pura, testeable)
# La IA puede devolver campos faltantes, tipos raros o basura parcial. Aquí se
# sanea TODO a la forma del contrato: defaults defensivos, tipos/confianza
# dentro del set válido, centavos enteros o None, strings recortados y máximo
# 100 líneas. Si el JSON es parseable, la respuesta sale 200 aunque venga
# incompleta.
# ==========================================================================
def _a_texto(v, maximo: int = MAX_TEXTO):
    """Convierte a string recortado; None si no hay nada útil."""
    if v is None:
        return None
    if not isinstance(v, str):
        v = str(v)
    v = v.strip()
    return v[:maximo] if v else None


def _a_numero(v):
    """Convierte a número (int o float); None si no es numérico."""
    if isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        return v
    if isinstance(v, str):
        try:
            return float(v)
        except ValueError:
            return None
    return None


def _a_centavos(v):
    """Convierte a centavos enteros; None si no es numérico. NUNCA flotantes."""
    n = _a_numero(v)
    return int(round(n)) if n is not None else None


def _a_bool(v) -> bool:
    """Interpreta valores booleanos poco estrictos que pueda mandar la IA."""
    if isinstance(v, bool):
        return v
    if isinstance(v, (int, float)):
        return v != 0
    if isinstance(v, str):
        return v.strip().lower() in ("true", "1", "si", "sí", "yes")
    return False


def _normalizar_linea(linea) -> dict | None:
    """Sanea una línea del ticket. Devuelve None si no es un objeto usable."""
    if not isinstance(linea, dict):
        return None
    nombre_crudo = _a_texto(linea.get("nombre_crudo")) or ""
    nombre_sugerido = _a_texto(linea.get("nombre_sugerido")) or nombre_crudo
    tipo = linea.get("tipo")
    if not isinstance(tipo, str) or tipo not in TIPOS_VALIDOS:
        tipo = "venta"  # defensivo: lo desconocido entra como venta
    confianza = linea.get("confianza")
    if not isinstance(confianza, str) or confianza not in CONFIANZAS_VALIDAS:
        confianza = "media"
    unidad = linea.get("unidad_ticket")
    if not isinstance(unidad, str) or unidad not in ("pieza", "caja", "pack"):
        unidad = None
    return {
        "nombre_crudo": nombre_crudo,
        "nombre_sugerido": nombre_sugerido,
        "codigo_barras": _a_texto(linea.get("codigo_barras"), 20),
        "cantidad": _a_numero(linea.get("cantidad")) or 0,
        "unidad_ticket": unidad,
        "piezas_por_empaque": _a_centavos(linea.get("piezas_por_empaque")),
        "costo_unitario_centavos": _a_centavos(linea.get("costo_unitario_centavos")) or 0,
        "importe_centavos": _a_centavos(linea.get("importe_centavos")),
        "tipo": tipo,
        "confianza": confianza,
        "nota": _a_texto(linea.get("nota")),
    }


# Notas/mensajes del chequeo de sanidad (constantes para que los tests las usen).
NOTA_NO_CUADRA = "La línea no cuadra con su importe; revisa cantidad y costo."
NOTA_SOSPECHA_EMPAQUE = ("El nombre sugiere empaque múltiple; si es caja o "
                         "pack, ajústalo en la app con '¿viene en caja o pack?'.")


def _agregar_nota(linea: dict, nota: str) -> None:
    """Añade una nota a la línea sin pisar la que ya traiga."""
    if linea["nota"]:
        if nota not in linea["nota"]:
            linea["nota"] = f"{linea['nota']}; {nota}"[:MAX_TEXTO]
    else:
        linea["nota"] = nota


def _chequeo_sanidad(lineas: list, avisos: list) -> None:
    """Verificaciones deterministas (el servidor NO confía ciegamente en la IA).

    1. ARITMÉTICA: cantidad × costo_unitario vs. importe impreso. El importe es
       la PRUEBA DE VERDAD de cada línea. Si no cuadra (más allá del ±2% o 50
       centavos), NO corregimos nada en silencio: confianza "baja", nota en la
       línea y aviso global, para que el USUARIO decida en la app.
    2. EMPAQUE SOSPECHOSO: nombre que sugiere empaque múltiple (PACK, PK, K6,
       X4, CHAROLA, DISPLAY...) pero la línea viene como PIEZA con precio
       implausible para pieza suelta (>$80). Se baja la confianza a "media"
       (si era "alta") con nota explicativa. No se tocan los números.
    """
    for linea in lineas:
        if linea["tipo"] not in ("venta", "cambio"):
            continue

        # --- 1. Verificación aritmética ---
        cantidad = linea["cantidad"]
        costo = linea["costo_unitario_centavos"]
        importe = linea["importe_centavos"]
        if cantidad and costo and importe and cantidad > 0 and costo > 0 and importe > 0:
            diferencia = abs(cantidad * costo - importe)
            tolerancia = max(TOLERANCIA_PCT * importe, TOLERANCIA_MIN_CENTAVOS)
            if diferencia > tolerancia:
                linea["confianza"] = "baja"
                _agregar_nota(linea, NOTA_NO_CUADRA)
                nombre = linea["nombre_sugerido"] or linea["nombre_crudo"] or "sin nombre"
                avisos.append(f"'{nombre[:60]}': {NOTA_NO_CUADRA}")

        # --- 2. Empaque sospechoso leído como pieza ---
        if (linea["unidad_ticket"] in (None, "pieza")
                and linea["piezas_por_empaque"] is None
                and costo > UMBRAL_PRECIO_PIEZA_CENTAVOS
                and (REGEX_EMPAQUE.search(linea["nombre_crudo"] or "")
                     or REGEX_EMPAQUE.search(linea["nombre_sugerido"] or ""))
                and linea["confianza"] == "alta"):
            linea["confianza"] = "media"
            _agregar_nota(linea, NOTA_SOSPECHA_EMPAQUE)


def normalizar_ticket(dato) -> dict:
    """Sanea la respuesta de la IA a la forma exacta del contrato.

    Función pura: recibe lo que sea que haya parseado json.loads y devuelve un
    dict completo y seguro. Nunca lanza excepción por datos feos.
    """
    if not isinstance(dato, dict):
        dato = {}

    lineas_crudas = dato.get("lineas")
    if not isinstance(lineas_crudas, list):
        lineas_crudas = []
    lineas = []
    for linea in lineas_crudas[:MAX_LINEAS]:
        saneada = _normalizar_linea(linea)
        if saneada is not None:
            lineas.append(saneada)

    avisos_crudos = dato.get("avisos")
    if not isinstance(avisos_crudos, list):
        avisos_crudos = []
    avisos = [a for a in (_a_texto(x) for x in avisos_crudos[:20]) if a]

    # Chequeos de sanidad deterministas (después de sanear, antes de recortar).
    _chequeo_sanidad(lineas, avisos)

    return {
        "proveedor": _a_texto(dato.get("proveedor")),
        "proveedor_id": _a_texto(dato.get("proveedor_id"), 30) or "otro",
        "fecha": _a_texto(dato.get("fecha"), 10),
        "folio": _a_texto(dato.get("folio"), 40),
        "es_preventa": _a_bool(dato.get("es_preventa")),
        "lineas": lineas,
        "total_ticket_centavos": _a_centavos(dato.get("total_ticket_centavos")),
        "avisos": avisos[:30],
    }


# ==========================================================================
# Llamada HTTP a los proveedores (solo librerías estándar)
# ==========================================================================
class ErrorProveedor(Exception):
    """Fallo al hablar con la IA: HTTP distinto de 200, timeout o JSON feo.

    - status: código HTTP del proveedor si lo hubo (429, 500...), None si fue
      un error de red/timeout o de parseo.
    - reintentable: True cuando vale la pena intentar con OTRO candidato de la
      cadena de respaldo (429, 503, timeout/red y demás 5xx).
      Los 401/403 se tratan aparte (key inválida → saltar a la siguiente key)
      y un 400 genérico falla directo (la petición está mal para cualquiera).
    - SEGURIDAD: el detalle NUNCA incluye la API key (ni parcial).
    """

    def __init__(self, detalle: str, status: int | None = None, reintentable: bool = False):
        super().__init__(detalle)
        self.detalle = detalle
        self.status = status
        self.reintentable = reintentable


def _post_json(url: str, cuerpo: dict, cabeceras: dict | None = None) -> dict:
    """POST JSON con urllib. Lanza ErrorProveedor con detalle CORTO y legible."""
    datos = json.dumps(cuerpo).encode("utf-8")
    req = urllib.request.Request(url, data=datos, method="POST")
    req.add_header("Content-Type", "application/json")
    for clave, valor in (cabeceras or {}).items():
        req.add_header(clave, valor)
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_SEGUNDOS) as resp:
            crudo = resp.read(4 * 1024 * 1024)  # límite defensivo de lectura
    except urllib.error.HTTPError as e:
        detalle = ""
        try:
            detalle = e.read(4096).decode("utf-8", "replace")
        except Exception:
            pass
        raise ErrorProveedor(
            f"el proveedor respondió HTTP {e.code}: {detalle[:MAX_DETALLE_ERROR]}",
            status=e.code,
            reintentable=(e.code == 429 or e.code >= 500),
        )
    except (urllib.error.URLError, TimeoutError, socket.timeout, OSError) as e:
        raise ErrorProveedor(f"sin respuesta del proveedor (timeout o red): {e}",
                             status=None, reintentable=True)
    try:
        return json.loads(crudo.decode("utf-8", "replace"))
    except (ValueError, UnicodeDecodeError):
        raise ErrorProveedor("el proveedor no devolvió JSON válido")


def _parsear_json_de_texto(texto: str) -> dict:
    """Parsea el JSON que viene dentro del texto de la IA.

    Aunque pedimos responseMimeType="application/json", algunos modelos aún
    envuelven el JSON en cercas markdown (```json ... ```); esta red tolerante
    se queda como seguro, pase lo que pase.
    """
    t = (texto or "").strip()
    if t.startswith("```"):
        # quitar la cerca de apertura (```json o ```) y la de cierre
        t = t.split("\n", 1)[1] if "\n" in t else ""
        if t.rstrip().endswith("```"):
            t = t.rstrip()[:-3]
    try:
        return json.loads(t)
    except ValueError:
        raise ErrorProveedor("la IA no devolvió JSON parseable")


# ==========================================================================
# Cadena de respaldo doble: modelos × API keys (orden MODELO-MAJOR)
# Cada key de Gemini es un PROYECTO distinto con cuota propia: varias keys
# multiplican el techo gratis. El orden de intentos es MODELO-MAJOR:
#   para cada modelo de la cadena → para cada key en orden → intentar.
# Es decir: se agota el MEJOR modelo en TODAS las keys antes de degradar a un
# modelo peor. Así la calidad máxima dura lo posible y solo se baja a un
# modelo "lite" cuando el bueno se agotó en todas las cuentas. El servidor
# recuerda el último combo ganador y lo intenta primero la próxima vez.
# ==========================================================================
_ultimo_combo_bueno: tuple[int, str] | None = None  # (indice_key, modelo)


def _ordenar_combos(api_keys: list[str], modelos: list[str]) -> list[tuple[int, str]]:
    """Todos los combos (indice_key, modelo), MODELO primero; el ganador primero.

    Ejemplo con 2 keys y 3 modelos:
        m1/key1 → m1/key2 → m2/key1 → m2/key2 → m3/key1 → m3/key2
    """
    combos = [(ki, m) for m in modelos for ki in range(len(api_keys))]
    if _ultimo_combo_bueno in combos:
        combos.remove(_ultimo_combo_bueno)
        combos.insert(0, _ultimo_combo_bueno)
    return combos


def _llamar_gemini_un_modelo(imagen_b64: str, mime: str, api_key: str, modelo: str) -> dict:
    """Google Gemini (AI Studio): generateContent con imagen inline.

    temperature=0: modo determinista/robótico, lo correcto para OCR/extracción
    (con la temperatura por defecto la MISMA foto daba resultados distintos).
    """
    url = (f"https://generativelanguage.googleapis.com/v1beta/models/"
           f"{modelo}:generateContent?key={api_key}")
    cuerpo = {
        "contents": [{
            "parts": [
                {"text": PROMPT_EXTRACCION},
                {"inline_data": {"mime_type": mime, "data": imagen_b64}},
            ],
        }],
        "generationConfig": {"temperature": 0, "responseMimeType": "application/json"},
    }
    resp = _post_json(url, cuerpo)
    try:
        texto = resp["candidates"][0]["content"]["parts"][0]["text"]
    except (KeyError, IndexError, TypeError):
        raise ErrorProveedor("Gemini respondió sin contenido usable")
    return _parsear_json_de_texto(texto)


def _llamar_gemini(imagen_b64: str, mime: str, api_keys: list[str],
                   modelos: list[str]) -> tuple[dict, str]:
    """Intenta los combos (key, modelo) en orden (el último bueno primero).

    - 429/5xx/timeout/red: pasa al siguiente candidato (modelo o key).
    - 401/403: la key es inválida; se marca como muerta y se salta DIRECTO a la
      siguiente key (sin gastar los modelos restantes con ella). Solo se falla
      si TODAS las keys dan 401/403 (o se agotan los candidatos).
    - Otros errores no reintentables (400, JSON feo del proveedor): falla
      directo, fallaría igual con cualquier combo.
    Si todos fallan, lanza el ÚLTIMO error (el endpoint lo traduce: 429 → HTTP
    429 amable; resto → 502). Devuelve (datos_parseados, modelo_usado). NUNCA
    expone qué key se usó.
    """
    global _ultimo_combo_bueno
    ultimo_error: ErrorProveedor | None = None
    keys_muertas: set[int] = set()
    for ki, modelo in _ordenar_combos(api_keys, modelos):
        if ki in keys_muertas:
            continue  # no gastar peticiones con una key que ya dijo 401/403
        try:
            datos = _llamar_gemini_un_modelo(imagen_b64, mime, api_keys[ki], modelo)
            _ultimo_combo_bueno = (ki, modelo)
            return datos, modelo
        except ErrorProveedor as e:
            ultimo_error = e
            if e.status in (401, 403):
                keys_muertas.add(ki)  # key inválida: siguiente KEY, no modelo
            elif not e.reintentable:
                raise  # error no reintentable (400, etc.): no insistir
            # reintentable (429/5xx/timeout/red): sigue el siguiente combo
    raise ultimo_error or ErrorProveedor("no hay credenciales configuradas")


def _llamar_kimi(imagen_b64: str, mime: str, api_key: str, modelo: str) -> dict:
    """Kimi (Moonshot AI): API compatible con OpenAI, imagen como data URL."""
    url = "https://api.moonshot.ai/v1/chat/completions"
    cuerpo = {
        "model": modelo,
        "temperature": 0.1,
        "response_format": {"type": "json_object"},
        "messages": [{
            "role": "user",
            "content": [
                {"type": "text", "text": PROMPT_EXTRACCION},
                {"type": "image_url",
                 "image_url": {"url": f"data:{mime};base64,{imagen_b64}"}},
            ],
        }],
    }
    resp = _post_json(url, cuerpo, {"Authorization": f"Bearer {api_key}"})
    try:
        texto = resp["choices"][0]["message"]["content"]
    except (KeyError, IndexError, TypeError):
        raise ErrorProveedor("Kimi respondió sin contenido usable")
    return _parsear_json_de_texto(texto)


# ==========================================================================
# Endpoint: análisis de ticket de proveedor
# ==========================================================================
class PeticionTicket(BaseModel):
    # imagen_b64 opcional a nivel de esquema para poder responder 400 (en vez
    # del 422 de validación) cuando la app no la mande.
    imagen_b64: str | None = None
    mime: str = "image/jpeg"


@router.post("/ia/ticket")
def analizar_ticket(
    peticion: PeticionTicket,
    disp: Dispositivo = Depends(dispositivo_actual),
):
    """Analiza la foto de un ticket de proveedor y devuelve sus datos.

    NO guarda nada en la base de datos: solo foto → IA → análisis.
    """
    if not peticion.imagen_b64:
        raise HTTPException(400, "Falta la imagen del ticket (imagen_b64).")
    if len(peticion.imagen_b64) > MAX_B64_CARACTERES:
        raise HTTPException(
            413, "La foto es demasiado grande (máx. ~8 MB en base64). "
                 "Tómala de nuevo más de cerca o con menor resolución.")
    mime = (peticion.mime or "image/jpeg").strip()[:50]

    proveedor, api_keys, modelos = _config_ia()

    # MODO MOCK: no se llama a nadie; respuesta realista de prueba.
    if proveedor == "mock":
        salida = normalizar_ticket(RESPUESTA_MOCK)
        salida["mock"] = True
        salida["modelo_usado"] = "mock"
        return salida

    if proveedor not in ("gemini", "kimi"):
        raise HTTPException(
            503, f"IA no configurada: IA_PROVEEDOR='{proveedor}' no es válido "
                 "(use mock, gemini o kimi).")
    if not api_keys:
        raise HTTPException(503, "IA no configurada: falta IA_API_KEY.")

    try:
        if proveedor == "gemini":
            crudo, modelo_usado = _llamar_gemini(
                peticion.imagen_b64, mime, api_keys, modelos)
        else:
            # Kimi: la cadena de respaldo es solo de Gemini; se usa la 1ª key.
            crudo = _llamar_kimi(peticion.imagen_b64, mime, api_keys[0], modelos[0])
            modelo_usado = modelos[0]
    except ErrorProveedor as e:
        if e.status == 429:
            # TODOS los combos (keys × modelos) están saturados o sin cuota.
            raise HTTPException(
                429, "La IA está saturada o sin cuota por ahora (límite de "
                     "peticiones). Inténtalo de nuevo en unos minutos.")
        raise HTTPException(502, f"No se pudo analizar el ticket: {e.detalle}")

    salida = normalizar_ticket(crudo)
    salida["mock"] = False
    salida["modelo_usado"] = modelo_usado
    return salida
